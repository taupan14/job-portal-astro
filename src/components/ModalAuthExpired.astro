<div
  id="modal-auth-expired"
  class="fixed top-0 inset-x-0 z-[999] invisible"
  data-modal
>
  <div
    class="relative w-full h-dvh flex flex-col overflow-auto"
    data-lenis-prevent
  >
    <div
      class="flex flex-col pt-[var(--space-header)] mt-auto shrink-0 | lg:py-12 lg:my-auto"
    >
      <div class="grow w-full flex flex-col max-container">
        <div class="grid gap-4 | lg:grid-cols-12">
          <div
            class="grid-item col-span-full | lg:col-span-6 lg:col-start-4 | 2xl:col-span-4 2xl:col-start-5"
          >
            <div
              class="flex flex-col relative bg-white pt-4 rounded-t-lg pointer-events-auto | lg:rounded-lg"
              data-modal-content
            >
              <!-- Icon -->
              <div class="shrink-0 px-6 pt-6 pb-2 flex justify-center">
                <div
                  class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center"
                >
                  <svg
                    class="w-7 h-7 text-red-500"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </div>

              <!-- Heading -->
              <div class="shrink-0 px-6 py-4 | lg:py-6">
                <div class="flex flex-col gap-4 items-center text-center">
                  <div
                    class="text-sm leading-none font-bold uppercase tracking-wide text-primary-600"
                  >
                    Sesi Berakhir
                  </div>
                  <h4 class="w-full font-bold leading-none text-balance">
                    Anda Perlu Login<br />Kembali
                  </h4>
                  <p class="text-sm text-dark-400 leading-relaxed">
                    Sesi Anda telah berakhir atau tidak ditemukan.<br />
                    Silakan login ulang untuk melanjutkan.
                  </p>
                </div>
              </div>

              <!-- Actions -->
              <div class="shrink-0 px-6 py-4 | lg:py-6">
                <div class="grid gap-4">
                  <a
                    href="/login"
                    class="btn btn-primary"
                    data-hover-effect
                    data-barba-navigate="/login"
                  >
                    Login Sekarang
                  </a>
                </div>
                <button
                  type="button"
                  class="btn"
                  data-hover-effect
                  data-modal-hide
                >
                  Tutup
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
