---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiGet } from "../../lib/api";

const { slug } = Astro.params;
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
const API_URL = import.meta.env.PUBLIC_API_URL;
const API_PUBS_URL = API_URL + "/pubs/uploads/blog";

type Blog = {
  id: number;
  title: string;
  slug: string;
  excerpt: string;
  content: string;
  thumbnail: string | null;
  status: string;
  published_at: string;
  category: {
    id: number;
    name: string;
  };
};
type ApiResp = {
  blog: Blog;
  related: Blog[];
};

const resp = await apiGet<ApiResp>(`/api/blogs/slug/${slug}`, cookieHeader);
const blog = resp?.blog;
const related = resp?.related ?? [];

// console.log("product", product);
// console.log("related", related);

// 404 jika tidak ditemukan
if (!blog) return Astro.redirect("/404");

const dateDormatted = new Date(blog.published_at).toLocaleDateString("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const parts = dateDormatted.split(" ");
const formatted = `${parts[0]} ${parts[1]}, ${parts[2]}`;
const pageTitle = blog.title;
---

<BaseLayout title={pageTitle}>
  <!-- Paste HTML dari index.html di sini -->
  <html lang="en">
    <div id="app">
      <!-- @components sectionHeader -->

      <main id="section-main" data-barba="wrapper">
        <div
          data-header-scheme="light"
          data-barba="container"
          data-barba-namespace="blog-detail"
        >
          <section id="page-header" class="relative pt-(--space-header)">
            <div class="relative py-16 | lg:pt-24">
              <div class="max-container">
                <div class="grid gap-8 | lg:grid-cols-12">
                  <div class="col-span-full | lg:col-span-8 lg:col-start-3">
                    <div class="flex flex-col gap-6 items-center text-center">
                      <div class="inline-flex items-center gap-3">
                        <div
                          class="size-1.5 rounded-full bg-primary-600 shrink-0"
                        >
                        </div>
                        <div
                          class="text-sm leading-none font-bold uppercase tracking-wide"
                        >
                          {blog.category.name}
                        </div>
                      </div>
                      <h1 class="text-balance">
                        {blog.title}
                      </h1>
                      <div
                        class="text-sm leading-none font-bold uppercase tracking-wide"
                      >
                        {formatted}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="absolute inset-0 flex justify-center -z-1 pointer-events-none select-none"
              >
                <h1
                  class="shrink-0 text-transparent [-webkit-text-stroke:1px_var(--color-dark-100)] leading-[0.8] uppercase whitespace-nowrap [--min-size:10rem] [--val-size:22vw] [--max-size:22rem]"
                >
                  Berita
                </h1>
              </div>
            </div>
            <div class="max-full-container">
              <div
                class="aspect-4/3 overflow-clip | not-lg:-mx-4 | lg:rounded-lg lg:aspect-21/9"
              >
                <picture>
                  <source
                    type="image/webp"
                    srcset={`
      ${API_PUBS_URL}/${blog.thumbnail}?w=400 400w,
      ${API_PUBS_URL}/${blog.thumbnail}?w=800 800w,
      ${API_PUBS_URL}/${blog.thumbnail}?w=1200 1200w,
      ${API_PUBS_URL}/${blog.thumbnail}?w=1600 1600w
    `}
                    sizes="100vw"
                  />
                  <img
                    src={`${API_PUBS_URL}/${blog.thumbnail}`}
                    srcset={`
      ${API_PUBS_URL}/${blog.thumbnail}?w=400 400w,
      ${API_PUBS_URL}/${blog.thumbnail}?w=800 800w,
      ${API_PUBS_URL}/${blog.thumbnail}?w=1200 1200w,
      ${API_PUBS_URL}/${blog.thumbnail}?w=1600 1600w
    `}
                    sizes="100vw"
                    decoding="async"
