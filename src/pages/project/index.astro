---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Project Kami">
  <!-- Paste HTML dari index.html di sini -->
  <html lang="en">
    <div id="app">
      <!-- @components sectionHeader -->

      <main id="section-main" data-barba="wrapper">
        <div
          data-hero-scheme="light"
          data-barba="container"
          data-barba-namespace="project"
        >
          <section id="page-header" class="relative pt-(--space-header)">
            <div class="relative py-16 | lg:pt-24">
              <div class="max-container">
                <div class="grid gap-8 | lg:grid-cols-12">
                  <div class="col-span-full | lg:col-span-8 lg:col-start-3">
                    <div class="flex flex-col gap-6 items-center text-center">
                      <div class="inline-flex items-center gap-3">
                        <div
                          class="size-1.5 rounded-full bg-primary-600 shrink-0"
                        >
                        </div>
                        <div
                          class="text-sm leading-none font-bold uppercase tracking-wide text-dark-950"
                        >
                          Project
                        </div>
                      </div>
                      <h1 class="leading-none text-balance">
                        Inovasi dalam Project Runlapan
                      </h1>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="absolute inset-0 flex justify-center -z-1 pointer-events-none select-none"
              >
                <h1
                  class="shrink-0 text-transparent [-webkit-text-stroke:1px_var(--color-dark-100)] leading-[0.8] uppercase whitespace-nowrap [--min-size:10rem] [--val-size:22vw] [--max-size:22rem]"
                >
                  Project
                </h1>
              </div>
            </div>
          </section>

          <section id="page-content" class="relative">
            <div class="py-16 | lg:py-24">
              <div class="accordion grid -mt-8" data-parent>
                <div class="relative accordion-item py-8 group" data-scroll-top>
                  <a
                    href="javascript:;"
                    class="relative block max-container"
                    data-target="project-1"
                  >
                    <div class="grid grid-cols-12 gap-4 | lg:gap-8">
                      <div class="col-span-2 | lg:col-span-3">
                        <div
                          class="text-sm leading-none font-bold tracking-wide text-dark-950"
                        >
                          01
                        </div>
                      </div>
                      <div class="col-span-8 | lg:col-span-6">
                        <div class="flex flex-col gap-1">
                          <div class="text-sm">Project</div>
                          <h4
                            class="text-balance leading-none tracking-normal transition-colors duration-800 ease-custom [--min-size:var(--text-3xl)] [.is-open_&]:text-primary-600"
                          >
                            Security
                          </h4>
                        </div>
                      </div>
                      <div class="col-span-2 text-end | lg:col-span-3">
                        <svg
                          class="icon icon-stroke size-6 text-primary-600 transition-all duration-800 ease-custom [.is-open_&]:rotate-180"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M17.5 6.5L6 18"
                            stroke="#141B34"
                            stroke-width="1.5"
                            stroke-linecap="square"></path>
                          <path
                            d="M8 6H18V16"
                            stroke="#141B34"
                            stroke-width="1.5"
                            stroke-linecap="square"></path>
                        </svg>
                      </div>
                    </div>
                    <div
                      class="absolute inset-0 flex items-center pointer-events-none z-10"
                    >
                      <div class="w-full max-container shrink-0">
                        <div class="grid gap-8 | lg:grid-cols-12">
                          <div
                            class="col-span-full | lg:col-span-3 lg:col-start-9"
                          >
                            <div
                              class="aspect-4/3 rounded-lg bg-black overflow-clip opacity-0 translate-y-1/4 transition-all duration-800 ease-custom group-hover:opacity-100 group-hover:translate-y-0 [.is-open_&]:opacity-0"
                            >
                              <img
                                src="./assets/images/thumbnails/img01.webp"
                                alt=""
                                class="size-full object-cover"
                              />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                  <div
                    id="project-1"
                    class="accordion-content overflow-clip"
                    aria-expanded="false"
                  >
                    <div class="max-container py-8 | lg:py-16">
                      <div
                        class="grid gap-8 mb-8 | lg:grid-cols-12 lg:gap-16 lg:mb-16"
                      >
                        <div class="col-span-full | lg:col-span-6">
                          <div
                            class="relative | lg:h-full lg:-ml-8 lg:-mr-8 | 2xl:-ml-[calc((100vw-var(--breakpoint-2xl))/2)]"
                          >
                            <div
                              class="aspect-video overflow-clip rounded-lg | lg:rounded-l-none lg:size-full"
                            >
                              <img
                                src="./assets/images/thumbnails/img01.webp"
                                alt=""
                                class="size-full object-cover"
                              />
                            </div>
                          </div>
                        </div>
                        <div
                          class="col-span-full | lg:col-span-5 lg:col-start-8"
                        >
                          <div
                            class="flex flex-col gap-8 py-8 | lg:h-full lg:justify-center lg:gap-16"
                          >
                            <div class="flex flex-col gap-4 | lg:gap-6">
                              <div
                                class="text-sm leading-none font-bold uppercase tracking-wide text-primary-600"
                              >
                                Security
                              </div>
                              <h3 class="leading-none text-balance">
                                Security, atau Satuan Pengamanan
                              </h3>
                            </div>
                            <article
                              class="post-entry no-grid [&>*]:!text-[size:inherit] [&>*]:!leading-[inherit]"
                            >
                              <p>
                                Memainkan peran penting dalam memastikan
                                keamanan dan ketertiban di berbagai lingkungan,
                                mulai dari gedung perkantoran hingga kompleks
                                perumahan. Mereka bukan hanya penjaga pintu,
                                tetapi garda terdepan dalam menjaga keamanan
                                orang dan aset.
                              </p>
                              <p>
                                Berikut adalah gambaran lengkap mengenai peran
                                dan tanggung jawab seorang security :
                              </p>
                            </article>
                          </div>
                        </div>
                      </div>
                      <div
                        class="grid gap-x-8 gap-y-16 | lg:grid-cols-3 lg:gap-16 | 2xl:grid-cols-4"
                      >
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Keamanan Fisik</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Pemantauan dan Patroli
                              </h5>
                            </div>
                            <p>
                              Security bertugas untuk memantau area yang mereka
                              jaga dan melakukan patroli rutin untuk mencegah
                              potensi risiko atau kegiatan mencurigakan.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Keamanan Fisik</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Kontrol Akses
                              </h5>
                            </div>
                            <p>
                              Memastikan bahwa hanya individu yang diizinkan
                              yang dapat masuk ke dalam suatu area tertentu,
                              biasanya melalui penggunaan kartu akses atau
                              prosedur identifikasi lainnya.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Keamanan Fisik</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Penanganan Keadaan Darurat
                              </h5>
                            </div>
                            <p>
                              Berperan dalam merespon situasi darurat, seperti
                              kebakaran atau serangan, dengan memberikan
                              pertolongan pertama dan membantu proses evakuasi.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Penerimaan dan Informas</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Penerimaan Pengunjung
                              </h5>
                            </div>
                            <p>
                              Menyambut pengunjung dengan ramah, memberikan
                              petunjuk atau informasi yang diperlukan, dan
                              menciptakan suasana yang aman dan nyaman.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Penerimaan dan Informas</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Penanganan Panggilan Telepon
                              </h5>
                            </div>
                            <p>
                              Security seringkali menjadi pusat komunikasi
                              pertama, menangani panggilan telepon, dan
                              mengarahkannya ke departemen yang bersangkutan.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Keterampilan Komunikasi</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Komunikasi Efektif
                              </h5>
                            </div>
                            <p>
                              Security perlu memiliki keterampilan komunikasi
                              yang baik untuk berinteraksi dengan penghuni atau
                              pengunjung dengan sopan dan jelas.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Keterampilan Komunikasi</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Penanganan Konflik
                              </h5>
                            </div>
                            <p>
                              Mampu menangani konflik dengan tenang dan secara
                              diplomatis, meminimalkan potensi eskalasi dan
                              menciptakan lingkungan yang aman.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Kesadaran Situasional</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Pemantauan CCTV
                              </h5>
                            </div>
                            <p>
                              Mampu menangani konflik dengan tenang dan secara
                              diplomatis, meminimalkan potensi eskalasi dan
                              menciptakan lingkungan yang aman.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">Kesadaran Situasional</div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Identifikasi Potensi Ancaman
                              </h5>
                            </div>
                            <p>
                              Mampu mengenali tanda-tanda potensi ancaman atau
                              risiko keamanan dan memberi tahu pihak yang
                              berwenang.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">
                                Kepatuhan Protokol Keamanan
                              </div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Penerapan Prosedur Keamanan
                              </h5>
                            </div>
                            <p>
                              Mengikuti prosedur keamanan yang telah ditetapkan,
                              termasuk penggunaan peralatan keamanan dan
                              pelaksanaan protokol evakuasi.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm">
                                Kepatuhan Protokol Keamanan
                              </div>
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Kontrol Barang Bawaan
                              </h5>
                            </div>
                            <p>
                              Memeriksa barang bawaan pengunjung atau karyawan,
                              jika diperlukan, untuk mencegah masuknya
                              benda-benda yang dapat membahayakan keamanan.
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="absolute bottom-0 inset-x-0 h-px bg-dark-400 max-w-screen-2xl mx-auto [.accordion-item:last-child_&]:hidden"
                  >
                  </div>
                </div>

                <div class="relative accordion-item py-8 group" data-scroll-top>
                  <a
                    href="javascript:;"
                    class="relative block max-container"
                    data-target="project-2"
                  >
                    <div class="grid grid-cols-12 gap-4 | lg:gap-8">
                      <div class="col-span-2 | lg:col-span-3">
                        <div
                          class="text-sm leading-none font-bold tracking-wide text-dark-950"
                        >
                          02
                        </div>
                      </div>
                      <div class="col-span-8 | lg:col-span-6">
                        <div class="flex flex-col gap-1">
                          <div class="text-sm">Project</div>
                          <h4
                            class="text-balance leading-none tracking-normal transition-colors duration-800 ease-custom [--min-size:var(--text-3xl)] [.is-open_&]:text-primary-600"
                          >
                            Outsourcing
                          </h4>
                        </div>
                      </div>
                      <div class="col-span-2 text-end | lg:col-span-3">
                        <svg
                          class="icon icon-stroke size-6 text-primary-600 transition-all duration-800 ease-custom [.is-open_&]:rotate-180"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M17.5 6.5L6 18"
                            stroke="#141B34"
                            stroke-width="1.5"
                            stroke-linecap="square"></path>
                          <path
                            d="M8 6H18V16"
                            stroke="#141B34"
                            stroke-width="1.5"
                            stroke-linecap="square"></path>
                        </svg>
                      </div>
                    </div>
                    <div
                      class="absolute inset-0 flex items-center pointer-events-none z-10"
                    >
                      <div class="w-full max-container shrink-0">
                        <div class="grid gap-8 | lg:grid-cols-12">
                          <div
                            class="col-span-full | lg:col-span-3 lg:col-start-9"
                          >
                            <div
                              class="aspect-4/3 rounded-lg bg-black overflow-clip opacity-0 translate-y-1/4 transition-all duration-800 ease-custom group-hover:opacity-100 group-hover:translate-y-0 [.is-open_&]:opacity-0"
                            >
                              <img
                                src="./assets/images/thumbnails/img02.webp"
                                alt=""
                                class="size-full object-cover"
                              />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                  <div
                    id="project-2"
                    class="accordion-content overflow-clip"
                    aria-expanded="false"
                  >
                    <div class="max-container py-8 | lg:py-16">
                      <div
                        class="grid gap-8 mb-8 | lg:grid-cols-12 lg:gap-16 lg:mb-16"
                      >
                        <div class="col-span-full | lg:col-span-6">
                          <div
                            class="relative | lg:h-full lg:-ml-8 lg:-mr-8 | 2xl:-ml-[calc((100vw-var(--breakpoint-2xl))/2)]"
                          >
                            <div
                              class="aspect-video overflow-clip rounded-lg | lg:rounded-l-none lg:size-full"
                            >
                              <img
                                src="./assets/images/thumbnails/img02.webp"
                                alt=""
                                class="size-full object-cover"
                              />
                            </div>
                          </div>
                        </div>
                        <div
                          class="col-span-full | lg:col-span-5 lg:col-start-8"
                        >
                          <div
                            class="flex flex-col gap-8 py-8 | lg:h-full lg:justify-center lg:gap-16"
                          >
                            <div class="flex flex-col gap-4 | lg:gap-6">
                              <div
                                class="text-sm leading-none font-bold uppercase tracking-wide text-primary-600"
                              >
                                Outsourcing
                              </div>
                              <h3 class="leading-none text-balance">
                                Pengertian Outsourcing
                              </h3>
                            </div>
                            <article
                              class="post-entry no-grid [&>*]:!text-[size:inherit] [&>*]:!leading-[inherit]"
                            >
                              <p>
                                Memberikan definisi dan pemahaman dasar tentang
                                apa itu outsourcing. Menjelaskan konsep di mana
                                perusahaan mengontrak pihak ketiga untuk
                                menyediakan layanan atau fungsi tertentu.
                              </p>
                              <p>
                                Di mana sebuah perusahaan menyerahkan sebagian
                                atau seluruh fungsi, layanan, atau proses
                                bisnisnya kepada pihak eksternal (vendor atau
                                penyedia jasa) untuk menghemat biaya,
                                meningkatkan efisiensi, atau fokus pada kegiatan
                                inti bisnis.
                              </p>
                            </article>
                          </div>
                        </div>
                      </div>
                      <div
                        class="grid gap-x-8 gap-y-16 | lg:grid-cols-3 lg:gap-16 | 2xl:grid-cols-4"
                      >
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Keamanan Fisik</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Manfaat Outsourcing untuk Bisnis
                              </h5>
                            </div>
                            <p>
                              Membahas manfaat ekonomis dan strategis dari
                              outsourcing. Ini mencakup penghematan biaya, fokus
                              pada inti bisnis, akses ke keahlian khusus, dan
                              fleksibilitas dalam skala operasional.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Keamanan Fisik</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Tipe-tipe Outsourcing
                              </h5>
                            </div>
                            <p>
                              Merinci berbagai jenis outsourcing, seperti
                              outsourcing IT, proses bisnis (BPO), pengembangan
                              perangkat lunak, dan layanan pelanggan. Setiap
                              jenis outsourcing memiliki karakteristik dan
                              keuntungan khususnya.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Keamanan Fisik</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Tantangan dalam Outsourcing
                              </h5>
                            </div>
                            <p>
                              Mengidentifikasi dan membahas tantangan yang
                              mungkin timbul dalam proses outsourcing. Ini dapat
                              mencakup perbedaan budaya, risiko keamanan,
                              pengelolaan jarak jauh, dan perubahan dalam
                              struktur organisasi.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Penerimaan dan Informas</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Strategi Memilih Mitra Outsourcing
                              </h5>
                            </div>
                            <p>
                              Memberikan panduan tentang bagaimana memilih mitra
                              outsourcing yang tepat. Ini termasuk penilaian
                              kualitas, pengalaman industri, reputasi, dan
                              kompatibilitas budaya.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Penerimaan dan Informas</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Keamanan Data dalam Outsourcing
                              </h5>
                            </div>
                            <p>
                              Membahas pentingnya keamanan data dalam konteks
                              outsourcing. Menyediakan informasi tentang
                              langkah-langkah keamanan yang dapat diambil untuk
                              melindungi informasi sensitif perusahaan yang
                              mungkin diakses oleh penyedia layanan.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Keterampilan Komunikasi</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Outsourcing vs. In-House
                              </h5>
                            </div>
                            <p>
                              Membandingkan keuntungan dan kerugian antara
                              menggunakan outsourcing dan menjalankan fungsi
                              tertentu secara internal. Menyajikan argumen untuk
                              memilih pendekatan tertentu berdasarkan kebutuhan
                              dan sumber daya.
                            </p>
                          </div>
                        </div>
                        <div class="col-span-full | lg:col-span-1">
                          <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                              <!-- <div class="text-sm">Keterampilan Komunikasi</div> -->
                              <h5
                                class="text-xl leading-tight tracking-normal text-balance"
                              >
                                Pengaruh Teknologi Terhadap Outsourcing
                              </h5>
                            </div>
                            <p>
                              Menjelaskan bagaimana perkembangan teknologi,
                              seperti konektivitas internet yang lebih baik dan
