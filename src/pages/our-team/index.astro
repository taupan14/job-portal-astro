---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Tim Kami">
  <!-- Paste HTML dari index.html di sini -->
  <html lang="en">
    <div id="app">
      <!-- @components sectionHeader -->

      <main id="section-main" data-barba="wrapper">
        <div
          data-header-scheme="light"
          data-barba="container"
          data-barba-namespace="team"
        >
          <section id="page-header" class="relative pt-(--space-header)">
            <div class="relative py-16 | lg:pt-24">
              <div class="max-container">
                <div class="grid gap-8 | lg:grid-cols-12">
                  <div class="col-span-full | lg:col-span-8 lg:col-start-3">
                    <div class="flex flex-col gap-6 items-center text-center">
                      <div class="inline-flex items-center gap-3">
                        <div
                          class="size-1.5 rounded-full bg-primary-600 shrink-0"
                        >
                        </div>
                        <div
                          class="text-sm leading-none font-bold uppercase tracking-wide text-dark-950"
                        >
                          Team Kami
                        </div>
                      </div>
                      <h1 class="leading-none text-balance">
                        Kenali Tim Kami <br />Yang Berpengalaman <br />di
                        Bidangnya
                      </h1>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
          <div
            class="absolute inset-0 flex justify-center -z-1 pointer-events-none select-none"
          >
            <h1
              class="shrink-0 text-transparent [-webkit-text-stroke:1px_var(--color-dark-100)] leading-[0.8] uppercase whitespace-nowrap [--min-size:10rem] [--val-size:22vw] [--max-size:22rem]"
            >
              Team Kami
            </h1>
          </div>
        </div>
      </main>

      <section id="page-content" class="relative">
        <div class="py-16 | lg:py-24">
          <div class="accordion grid -mt-8" data-parent>
            <div class="relative accordion-item py-8 group" data-scroll-top>
              <a
                href="javascript:;"
                class="relative block max-container"
                data-target="team-1"
              >
                <div class="grid grid-cols-12 gap-4 | lg:gap-8">
                  <div class="col-span-2 | lg:col-span-3">
                    <div
                      class="text-sm leading-none font-bold tracking-wide text-dark-950"
                    >
                      01
                    </div>
                  </div>
                  <div class="col-span-8 | lg:col-span-6">
                    <div class="flex flex-col gap-1">
                      <div class="text-sm">Team</div>
                      <h4
                        class="text-balance leading-none tracking-normal transition-colors duration-800 ease-custom [--min-size:var(--text-3xl)] [.is-open_&]:text-primary-600"
                      >
                        Marketing
                      </h4>
                    </div>
                  </div>
                  <div class="col-span-2 text-end | lg:col-span-3">
                    <svg
                      class="icon icon-stroke size-6 text-primary-600 transition-all duration-800 ease-custom [.is-open_&]:rotate-180"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M17.5 6.5L6 18"
                        stroke="#141B34"
                        stroke-width="1.5"
                        stroke-linecap="square"></path>
                      <path
                        d="M8 6H18V16"
                        stroke="#141B34"
                        stroke-width="1.5"
                        stroke-linecap="square"></path>
                    </svg>
                  </div>
                </div>
                <div
                  class="absolute inset-0 flex items-center pointer-events-none z-10 | not-lg:hidden"
                >
                  <div class="w-full max-container shrink-0">
                    <div class="grid gap-8 | lg:grid-cols-12">
                      <div class="col-span-full | lg:col-span-3 lg:col-start-9">
                        <div
                          class="aspect-4/3 rounded-lg bg-black overflow-clip opacity-0 translate-y-1/4 transition-all duration-800 ease-custom group-hover:opacity-100 group-hover:translate-y-0 [.is-open_&]:opacity-0"
                        >
                          <img
                            src="./assets/images/thumbnails/img01.webp"
                            alt=""
                            class="size-full object-cover"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
              <div
                id="team-1"
                class="accordion-content overflow-clip"
                aria-expanded="false"
              >
                <div class="max-container py-8 | lg:py-16">
                  <div
                    class="grid gap-8 mb-8 | lg:grid-cols-12 lg:gap-16 lg:mb-16"
                  >
                    <div class="col-span-full | lg:col-span-6">
                      <div
                        class="relative | lg:h-full lg:-ml-8 lg:-mr-8 | 2xl:-ml-[calc((100vw-var(--breakpoint-2xl))/2)]"
                      >
                        <div
                          class="aspect-video overflow-clip rounded-lg | lg:rounded-l-none lg:size-full"
                        >
                          <img
                            src="./assets/images/thumbnails/img01.webp"
                            alt=""
                            class="size-full object-cover"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-5 lg:col-start-8">
                      <div
                        class="flex flex-col gap-8 py-8 | lg:h-full lg:justify-center lg:gap-16"
                      >
                        <div class="flex flex-col gap-4 | lg:gap-6">
                          <div
                            class="text-sm leading-none font-bold uppercase tracking-wide text-primary-600"
                          >
                            Marketing
                          </div>
                          <h3 class="leading-none text-balance">
                            Kami Memiliki Tim Marketing yang Handal
                          </h3>
                        </div>
                        <article
                          class="post-entry no-grid [&>*]:!text-[size:inherit] [&>*]:!leading-[inherit]"
                        >
                          <p>
                            Pekerjaan dalam bidang pemasaran (marketing)
                            memiliki peran yang kritis dalam kesuksesan suatu
                            perusahaan. Berikut adalah beberapa fungsi utama
                            dari pekerjaan pemasaran
                          </p>
                        </article>
                      </div>
                    </div>
                  </div>
                  <div
                    class="grid gap-x-8 gap-y-16 | lg:grid-cols-3 lg:gap-16 | 2xl:grid-cols-4"
                  >
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Pengenalan Produk atau Layanan
                          </h5>
                        </div>
                        <p>
                          Memperkenalkan produk atau sajian, Membangun kesadaran
                          merek dan mengomunikasikan nilai unik dari produk atau
                          layanan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Pengembangan Strategi Pemasaran
                          </h5>
                        </div>
                        <p>
                          Rancang strategi pemasaran yang sesuai dengan itu,
                          Menganalisis pasar dan pesaing untuk mengidentifikasi
                          peluang dan tantangan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Penetapan Harga
                          </h5>
                        </div>
                        <p>
                          Menentukan strategi penetapan harga yang sesuai dengan
                          posisi pasar dan nilai produk. Memastikan bahwa harga
                          mencerminkan nilai produk dan dapat diterima oleh
                          pelanggan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Distribusi (Pemasaran)
                          </h5>
                        </div>
                        <p>
                          Merencanakan dan mengelola saluran distribusi untuk
                          mengoptimalkan ketersediaan produk. Memastikan produk
                          dapat diakses oleh target pasar dengan efisien.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Promosi
                          </h5>
                        </div>
                        <p>
                          Mengembangkan kampanye promosi untuk meningkatkan
                          penjualan dan kesadaran merek.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Penelitian Pasar
                          </h5>
                        </div>
                        <p>
                          Melakukan penelitian pasar untuk memahami kebutuhan
                          dan preferensi pelanggan. Menganalisis tren pasar dan
                          merespons perubahan dalam perilaku konsumen.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Pengelolaan Hubungan Pelanggan
                          </h5>
                        </div>
                        <p>
                          Membangun dan memelihara hubungan dengan pelanggan.
                          Menanggapi umpan balik pelanggan untuk meningkatkan
                          kepuasan pelanggan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Analisis Kinerja Pemasaran
                          </h5>
                        </div>
                        <p>
                          Melakukan analisis kinerja kampanye pemasaran untuk
                          mengukur ROI. Menggunakan data untuk membuat keputusan
                          yang lebih baik dan mengoptimalkan strategi pemasaran
                          di masa depan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Inovasi Produk dan Pengembangan
                          </h5>
                        </div>
                        <p>
                          Berkolaborasi dengan tim pengembangan produk untuk
                          memahami kebutuhan pasar. Memberikan wawasan pemasaran
                          untuk membentuk pengembangan produk yang sukses.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Manajemen Merek
                          </h5>
                        </div>
                        <p>
                          Membangun, memelihara, dan melindungi citra merek
                          perusahaan. Mengembangkan strategi untuk memposisikan
                          merek di pasar.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="absolute bottom-0 inset-x-0 h-px bg-dark-400 max-w-screen-2xl mx-auto [.accordion-item:last-child_&]:hidden"
              >
              </div>
            </div>

            <div class="relative accordion-item py-8 group" data-scroll-top>
              <a
                href="javascript:;"
                class="relative block max-container"
                data-target="team-2"
              >
                <div class="grid grid-cols-12 gap-4 | lg:gap-8">
                  <div class="col-span-2 | lg:col-span-3">
                    <div
                      class="text-sm leading-none font-bold tracking-wide text-dark-950"
                    >
                      02
                    </div>
                  </div>
                  <div class="col-span-8 | lg:col-span-6">
                    <div class="flex flex-col gap-1">
                      <div class="text-sm">Team</div>
                      <h4
                        class="text-balance leading-none tracking-normal transition-colors duration-800 ease-custom [--min-size:var(--text-3xl)] [.is-open_&]:text-primary-600"
                      >
                        Human Resource
                      </h4>
                    </div>
                  </div>
                  <div class="col-span-2 text-end | lg:col-span-3">
                    <svg
                      class="icon icon-stroke size-6 text-primary-600 transition-all duration-800 ease-custom [.is-open_&]:rotate-180"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M17.5 6.5L6 18"
                        stroke="#141B34"
                        stroke-width="1.5"
                        stroke-linecap="square"></path>
                      <path
                        d="M8 6H18V16"
                        stroke="#141B34"
                        stroke-width="1.5"
                        stroke-linecap="square"></path>
                    </svg>
                  </div>
                </div>
                <div
                  class="absolute inset-0 flex items-center pointer-events-none z-10"
                >
                  <div class="w-full max-container shrink-0">
                    <div class="grid gap-8 | lg:grid-cols-12">
                      <div class="col-span-full | lg:col-span-3 lg:col-start-9">
                        <div
                          class="aspect-4/3 rounded-lg bg-black overflow-clip opacity-0 translate-y-1/4 transition-all duration-800 ease-custom group-hover:opacity-100 group-hover:translate-y-0 [.is-open_&]:opacity-0"
                        >
                          <img
                            src="./assets/images/thumbnails/img02.webp"
                            alt=""
                            class="size-full object-cover"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
              <div
                id="team-2"
                class="accordion-content overflow-clip"
                aria-expanded="false"
              >
                <div class="max-container py-8 | lg:py-16">
                  <div
                    class="grid gap-8 mb-8 | lg:grid-cols-12 lg:gap-16 lg:mb-16"
                  >
                    <div class="col-span-full | lg:col-span-6">
                      <div
                        class="relative | lg:h-full lg:-ml-8 lg:-mr-8 | 2xl:-ml-[calc((100vw-var(--breakpoint-2xl))/2)]"
                      >
                        <div
                          class="aspect-video overflow-clip rounded-lg | lg:rounded-l-none lg:size-full"
                        >
                          <img
                            src="./assets/images/thumbnails/img02.webp"
                            alt=""
                            class="size-full object-cover"
                          />
                        </div>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-5 lg:col-start-8">
                      <div
                        class="flex flex-col gap-8 py-8 | lg:h-full lg:justify-center lg:gap-16"
                      >
                        <div class="flex flex-col gap-4 | lg:gap-6">
                          <div
                            class="text-sm leading-none font-bold uppercase tracking-wide text-primary-600"
                          >
                            Human Resource
                          </div>
                          <h3 class="leading-none text-balance">
                            Kami Memiliki Tim Human Resource yang Handal
                          </h3>
                        </div>
                        <article
                          class="post-entry no-grid [&>*]:!text-[size:inherit] [&>*]:!leading-[inherit]"
                        >
                          <p>
                            Departemen Sumber Daya Manusia (Human Resources atau
                            HR) memiliki peran yang sangat penting dalam
                            mengelola aspek-aspek terkait sumber daya manusia di
                            suatu organisasi. Berikut adalah beberapa fungsi
                            utama dari departemen HR :
                          </p>
                        </article>
                      </div>
                    </div>
                  </div>
                  <div
                    class="grid gap-x-8 gap-y-16 | lg:grid-cols-3 lg:gap-16 | 2xl:grid-cols-4"
                  >
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Rekrutmen dan Seleksi
                          </h5>
                        </div>
                        <p>
                          Menentukan kebutuhan SDM dan merancang strategi
                          rekrutmen. Melakukan proses seleksi dan perekrutan
                          untuk menemukan karyawan yang sesuai dengan kebutuhan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Manajemen Kinerja
                          </h5>
                        </div>
                        <p>
                          Mengembangkan sistem evaluasi kinerja. Memberikan
                          umpan balik kepada karyawan dan merancang program
                          pengembangan karyawan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Pelatihan dan Pengembangan
                          </h5>
                        </div>
                        <p>
                          Menilai kebutuhan pelatihan karyawan. Mendesain dan
                          menyelenggarakan program pelatihan untuk meningkatkan
                          keterampilan dan kompetensi.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Manajemen Konflik dan Penyelesaian Masalah
                          </h5>
                        </div>
                        <p>
                          Memberikan penyelesaian masalah yang adil dan efektif.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Manajemen Kompensasi dan Manfaat
                          </h5>
                        </div>
                        <p>
                          Menentukan struktur gaji dan kebijakan kompensasi.
                          Mengelola program manfaat karyawan, termasuk asuransi
                          kesehatan, cuti, dan kebijakan tunjangan lainnya.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Kepatuhan dan Pengelolaan Resiko
                          </h5>
                        </div>
                        <p>
                          Memastikan kepatuhan terhadap peraturan
                          ketenagakerjaan dan hukum ketenagakerjaan. Mengelola
                          risiko terkait dengan masalah-masalah ketenagakerjaan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Manajemen Hubungan Karyawan
                          </h5>
                        </div>
                        <p>
                          Membangun dan memelihara hubungan baik dengan
                          karyawan. Menanggapi kebutuhan dan keprihatinan
                          karyawan.
                        </p>
                      </div>
                    </div>
                    <div class="col-span-full | lg:col-span-1">
                      <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                          <!-- <div class="text-sm">Keamanan Fisik</div> -->
                          <h5
                            class="text-xl leading-tight tracking-normal text-balance"
                          >
                            Pengembangan Budaya Organisasi
                          </h5>
                        </div>
                        <p>
                          Mempromosikan nilai-nilai dan budaya perusahaan.
                          Mendorong lingkungan kerja yang inklusif dan berfokus
                          pada keberagaman.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="absolute bottom-0 inset-x-0 h-px bg-dark-400 max-w-screen-2xl mx-auto [.accordion-item:last-child_&]:hidden"
              >
              </div>
            </div>

            <div class="relative accordion-item py-8 group" data-scroll-top>
              <a
                href="javascript:;"
                class="relative block max-container"
                data-target="team-3"
              >
                <div class="grid grid-cols-12 gap-4 | lg:gap-8">
                  <div class="col-span-2 | lg:col-span-3">
                    <div
                      class="text-sm leading-none font-bold tracking-wide text-dark-950"
                    >
                      03
                    </div>
                  </div>
                  <div class="col-span-8 | lg:col-span-6">
                    <div class="flex flex-col gap-1">
                      <div class="text-sm">Team</div>
                      <h4
                        class="text-balance leading-none tracking-normal transition-colors duration-800 ease-custom [--min-size:var(--text-3xl)] [.is-open_&]:text-primary-600"
                      >
                        Recruitment
                      </h4>
                    </div>
                  </div>
                  <div class="col-span-2 text-end | lg:col-span-3">
                    <svg
                      class="icon icon-stroke size-6 text-primary-600 transition-all duration-800 ease-custom [.is-open_&]:rotate-180"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M17.5 6.5L6 18"
                        stroke="#141B34"
                        stroke-width="1.5"
                        stroke-linecap="square"></path>
                      <path
                        d="M8 6H18V16"
